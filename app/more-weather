  chmod 644 "$tmp"
  if cmp -s "$tmp" "$icon_file"; then
    rm -f "$tmp"
  else
    mv -f "$tmp" "$icon_file"
    if command -v gtk-update-icon-cache >/dev/null; then
      gtk-update-icon-cache -q -f "$data_home/icons/hicolor" 2>/dev/null || true
    fi
  fi
}

install_desktop_entry() {
  mkdir -p "$(dirname "$desktop_file")"
  write_icon
  cat >"$desktop_file" <<DESKTOP
[Desktop Entry]
Type=Application
Version=1.0
Name=More Weather
Comment=Weather, warnings, rain radar and wind map
Exec=$plugin_dir/app/more-weather
Icon=more-weather
Terminal=false
Categories=Utility;
Keywords=Weather;Forecast;Radar;Rain;Wind;
StartupNotify=true
DESKTOP
  echo "Added More Weather to the app launcher: $desktop_file"
}

remove_desktop_entry() {
  rm -f "$desktop_file" "$icon_file"
  echo "Removed More Weather from the app launcher."
}

case "${1:-}" in
--install-desktop-entry)
  install_desktop_entry
  exit 0
  ;;
--remove-desktop-entry)
  remove_desktop_entry
  exit 0
  ;;
-h | --help)
  sed -n '4,6p' "$0" | sed 's/^#   /  /'
  exit 0
  ;;
"") ;;
*)
  echo "more-weather: unknown option: $1" >&2
  exit 1
  ;;
esac

prepare_config
# Keeps an installed launcher icon in step with theme changes.
[[ -f $desktop_file ]] && write_icon

export QS_APP_ID="more-weather"
if timeout 2s qs ipc -n -p "$config_dir" call -- more-weather open >/dev/null 2>&1; then
  exit 0
fi
exec qs -n -d -p "$config_dir"
